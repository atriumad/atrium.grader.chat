# Hash (sha256 hex) of each caller's API key. Generate with: npm run new-key -w @atrium/agent
AGENT_KEY_HASH_GRADER=
AGENT_KEY_HASH_ATRIUM=
AGENT_PORT=4100
# Optional: path to the config file (default: agent.config.yaml next to package.json)
# AGENT_CONFIG=

# Lookups (same keys as apps/web)
GOOGLE_PLACES_API_KEY=
SCRAPECREATORS_API_KEY=
# SOCIAL_NETWORKS=instagram,facebook,tiktok,youtube

# Social provider used by the lookups (apify is the current one)
# SOCIAL_PROVIDER=apify
# APIFY_TOKEN=
# Port: AGENT_PORT, or PORT when the host platform sets it (default 4100)
