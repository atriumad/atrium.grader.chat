{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-ME.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-ME.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
