# Server-side only. Copy to .env.local and fill in.
GOOGLE_PLACES_API_KEY=
SCRAPECREATORS_API_KEY=

# Analysis provider:
#   claude-cli (default) = uses your Claude plan through the local `claude` CLI (must be logged in). Personal/local use only.
#   api                  = uses ANTHROPIC_API_KEY. Required if the app is served to customers.
ANALYSIS_PROVIDER=claude-cli
CLAUDE_CLI_MODEL=sonnet
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Agenda (chat) ---
# none (default) = el agente dice que la agenda no está disponible. mock = agenda de prueba, no reserva nada real.
# google = Google Calendar real (necesita las 3 variables GOOGLE_* de abajo).
BOOKING_PROVIDER=none
BOOKING_TIMEZONE=America/New_York
BOOKING_HOURS=09:00-17:00
BOOKING_DAYS=1,2,3,4,5
BOOKING_DURATION_MIN=30
BOOKING_MIN_NOTICE_HOURS=12
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# --- Redes sociales a leer (cada red cuesta ~2 créditos de ScrapeCreators por negocio) ---
# Por defecto: instagram,facebook,tiktok,youtube. Las extra solo se leen si el sitio web del negocio enlaza a ellas.
# SOCIAL_NETWORKS=instagram,facebook,tiktok,youtube

# --- Panel administrativo (/admin) ---
# Sin estas variables la app funciona igual, con las reglas y prompts por defecto del código.
# Supabase: Project Settings -> API. La service_role es SECRETA: solo en el servidor.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden entrar al panel (separados por comas). Acceso con enlace al correo.
# ADMIN_EMAILS=tu@correo.com

# --- Agente de investigación (apps/agent) ---
# ANALYZE_VIA_AGENT=1 hace que el grader pida los datos del negocio al servicio del agente.
# Si el servicio está apagado, falla o no puede elegir un local, el grader usa su flujo propio.
# ANALYZE_VIA_AGENT=1
# AGENT_URL=http://localhost:8787
# AGENT_API_KEY=   # la clave en claro del llamador "grader" (en el agente solo vive su hash)

# --- Security ---
# Public URL of the site (no trailing slash). Used for magic links instead of the request Host header.
# SITE_URL=
# Maximum analyses per rolling 24 hours across all visitors (each one spends paid credits). Default 400.
# ANALYZE_DAILY_CAP=
